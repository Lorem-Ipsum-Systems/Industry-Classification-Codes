{
    "name": "loremipsum-system/industry-classification-codes",
    "description": "Public PHP Industry Classification Codes Package",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Lorem Ipsum Dev"
        }
    ],
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "LoremIpsum\\IndustryClassificationCodes\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LoremIpsum\\IndustryClassificationCodes\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
